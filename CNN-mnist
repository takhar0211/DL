
import numpy as np
import matplotlib.pyplot as plt
from tensorflow import keras
from tensorflow.keras import layers

# 1. Load MNIST dataset
data = np.load('digits_dataset_28x28 (1).npz')

x_train = data['x_train']
y_train = data['y_train']
x_test = data['x_test']
y_test = data['y_test']

# 2. Normalize images
x_train = x_train.astype('float32') / 255.0
x_test = x_test.astype('float32') / 255.0

# 3. Add channel dimension
x_train = x_train[..., np.newaxis]
x_test = x_test[..., np.newaxis]

# 4. Define CNN architecture
model = keras.Sequential([
    layers.Input(shape=(28, 28, 1)),
    layers.Conv2D(32, (3, 3), activation='relu'),
    layers.MaxPooling2D((2, 2)),
    layers.Flatten(),
    layers.Dense(128, activation='relu'),
    layers.Dense(10, activation='softmax')
])

# Display model architecture
model.summary()

# 5. Compile model
model.compile(
    optimizer='sgd',
    loss='sparse_categorical_crossentropy',
    metrics=['accuracy']
)

# 6. Train model
history = model.fit(
    x_train,
    y_train,
    epochs=5
)

# 7. Evaluate model
loss, accuracy = model.evaluate(x_test, y_test)

print("Test Loss:", loss)
print("Test Accuracy:", accuracy)

# 8. Plot accuracy
plt.plot(history.history['accuracy'])
plt.title('Model Accuracy')
plt.xlabel('Epochs')
plt.ylabel('Accuracy')
plt.show()

# 9. Plot loss
plt.plot(history.history['loss'])
plt.title('Model Loss')
plt.xlabel('Epochs')
plt.ylabel('Loss')
plt.show()

# 10. Predict one test image
image = x_test[0]

prediction = model.predict(image.reshape(1, 28, 28, 1))

predicted = np.argmax(prediction)
actual = int(y_test[0])

# 11. Display image
plt.imshow(image.squeeze(), cmap='gray')
plt.title('Handwritten Digit')
plt.axis('off')
plt.show()

# 12. Display prediction
print("Predicted Digit:", predicted)
print("Actual Digit:", actual)

if predicted == actual:
    print("Correct Prediction!")
else:
    print("Wrong Prediction!")
