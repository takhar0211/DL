# ===== Code Block 1 =====
# ECG Anomaly Detection using Autoencoder
import pandas as pd, numpy as np, seaborn as sns, matplotlib.pyplot as plt, tensorflow as tf
from tensorflow.keras import layers, models
from sklearn.model_selection import train_test_split
from sklearn.preprocessing import MinMaxScaler
from sklearn.metrics import accuracy_score, confusion_matrix

# ===== Code Block 2 =====
# Load dataset
data = pd.read_csv("ecg.xls", header=None)
X = data.iloc[:, :-1].values
y = data.iloc[:, -1].values

# ===== Code Block 3 =====
# Train-Test Split (Novelty detection: train only on normal samples)
X_train, X_test, y_train, y_test = train_test_split(X, y, test_size=0.2, stratify=y, random_state=42)
X_train = X_train[y_train == 1]   # only normal samples for training

# ===== Code Block 4 =====
# Normalize
scaler = MinMaxScaler()
X_train_s = scaler.fit_transform(X_train)
X_test_s  = scaler.transform(X_test)
# Display shapes after scaling
print("Train Shape after scaling:", X_train_s.shape)
print("Test Shape after scaling :", X_test_s.shape)

# ===== Code Block 6 =====
# Build Autoencoder
input_dim = X_train_s.shape[1]
autoencoder = models.Sequential([
    layers.Input(shape=(input_dim,)),
    layers.Dense(64, activation='relu'),
    layers.Dense(32, activation='relu'),
    layers.Dense(16, activation='relu'),
    layers.Dense(8, activation='relu'),
    layers.Dense(16, activation='relu'),
    layers.Dense(32, activation='relu'),
    layers.Dense(64, activation='relu'),
    layers.Dense(input_dim, activation='sigmoid')
])

# ===== Code Block 7 =====
autoencoder.compile(optimizer=Adam(0.001),
                    loss='mean_squared_logarithmic_error',
                    metrics=['mse'])

# ---------------- Autoencoder Summary ----------------
autoencoder.summary()

# ===== Code Block 13 =====
# Train Model
history = autoencoder.fit(X_train_s, X_train_s,
                          epochs=20, batch_size=512,
                          validation_data=(X_test_s, X_test_s),
                          verbose=1)

# ===== Code Block 15 =====
# Plot loss
plt.plot(history.history['loss'], label="Train Loss")
plt.plot(history.history['val_loss'], label="Validation Loss")
plt.xlabel("Epochs")
plt.ylabel("MSE Loss")
plt.title("Training vs Validation Loss")
plt.legend()
plt.show()

# ===== Code Block 16 =====
# Reconstruction error
recon_train = autoencoder.predict(X_train_s)
recon_test  = autoencoder.predict(X_test_s)
train_err = np.mean(np.square(X_train_s - recon_train), axis=1)
test_err  = np.mean(np.square(X_test_s - recon_test), axis=1)

# Threshold
threshold = np.mean(train_err) + np.std(train_err)

# Predictions
y_pred = [1 if e > threshold else 0 for e in test_err]
acc = accuracy_score(y_test, y_pred)
cm = confusion_matrix(y_test, y_pred)

print("Reconstruction Threshold:", threshold)
print("Accuracy:", acc)


print("Confusion Matrix:\n", cm)

sns.heatmap(cm, annot=True, fmt="d", cmap="Blues")
plt.title("Confusion Matrix")
plt.xlabel("Predicted")
plt.ylabel("Actual")
plt.show()

